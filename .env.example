# Application Configuration
PROJECT_NAME="Advanced Multi-Agent AI Orchestrator"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
ENVIRONMENT="development"
HOST="127.0.0.1"
PORT=8000

# PostgreSQL Async Database Connection
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://agent_orchestrator_user:your_secure_password_here@localhost:5433/agent_orchestrator

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

